node_modules/

# ====================
# Carpeta media de Django
# ====================
# Ignora todo en media
servidor/media/*

# Excepto archivos default.jpg que quieras conservar
!servidor/media/espacios/default.jpg
!servidor/media/plantas/default.jpg
!servidor/media/especies/default.jpg
!servidor/media/fotos_perfil_usuarios/default.jpg

