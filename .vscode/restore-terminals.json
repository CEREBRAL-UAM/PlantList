{
  "artificialDelayMilliseconds": 700,
  "keepExistingTerminalsOpen": false,
  "runOnStartup": false,
  "terminals": [
    {
      "splitTerminals": [
        {
          "name": "docker-compose",
          "commands": [
            "docker-compose down -v",
            "docker-compose up -d",
            "docker-compose up --build"
          ]
        }
      ]
    },
    {
      "splitTerminals": [
        {
          "name": "backend-terminal",
          "commands": [
            "docker exec -it biolink-backend bash"
          ]
        }
      ]
    },
    {
      "splitTerminals": [
        {
          "name": "frontend-terminal",
          "commands": [
            "docker exec -it biolink-frontend bash"
          ]
        }
      ]
    },
    {
      "splitTerminals": [
        {
          "name": "mysql-terminal",
          "commands": [
            "docker exec -it biolink-db bash"
          ]
        }
      ]
    },
    {
      "splitTerminals": [
        {
          "name": "git-terminal",
          "commands": [
            "git status"
          ]
        }
      ]
    }
  ]
}
