{
  "artificialDelayMilliseconds": 700,
  "keepExistingTerminalsOpen": false,
  "runOnStartup": false,
  "terminals": [
    {
      "splitTerminals": [
        {
          "name": "django_term",
          "commands": [".\\venv\\Scripts\\activate"]
        },
        {
          "name": "backend_server",
          "commands": [
            ".\\venv\\Scripts\\activate",
            "python manage.py runserver"
          ]
        }
      ]
    },
    {
      "splitTerminals": [
        {
          "name": "react_term",
          "commands": [".\\venv\\Scripts\\activate", "cd cliente"]
        },
        {
          "name": "frontend_server",
          "commands": [
            ".\\venv\\Scripts\\activate",
            "cd cliente",
            "npm run dev"
          ]
        }
      ]
    }
  ]
}
